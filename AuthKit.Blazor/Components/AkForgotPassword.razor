@inherits AkComponentBase
@inject IAuthKitApi Api
@inject AuthKitUiOptions Options

<AkShell Title="@L["forgot.title"]" Subtitle="@(_sent ? null : L["forgot.subtitle"])" Embedded="Embedded">
    @if (_sent)
    {
        <div class="ak-alert ak-alert--success" role="status">@L["forgot.sent"]</div>
    }
    else
    {
        <form class="ak-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault novalidate>
            <AkErrorAlert Error="_error" />

            <AkField Id="ak-forgot-email" Label="@L["common.email"]" Type="AkFieldType.Email" Required="true"
                     Autocomplete="email" @bind-Value="_email" Error="@_emailError" />

            <AkSubmit Busy="_busy" Text="@L["forgot.submit"]" />
        </form>
    }

    <div class="ak-footer"><a class="ak-link" href="@Options.Routes.Login">@L["common.back_to_login"]</a></div>
</AkShell>

@code {
    [Parameter] public bool Embedded { get; set; }

    private string _email = "";
    private string? _emailError;
    private ApiError? _error;
    private bool _busy;
    private bool _sent;

    private async Task SubmitAsync()
    {
        if (_busy) return;

        _error = null;
        _emailError = AkValidation.Email(L, _email);
        if (_emailError is not null) return;

        _busy = true;
        try
        {
            var result = await Api.ForgotPasswordAsync(_email.Trim());
            if (result.IsSuccess) _sent = true;   // نفس الرد للبريد الموجود وغير الموجود
            else _error = result.Error;
        }
        finally { _busy = false; }
    }
}