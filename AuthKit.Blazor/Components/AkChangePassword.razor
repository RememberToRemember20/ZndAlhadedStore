@inherits AkComponentBase
@inject IAuthKitApi Api
@inject AuthKitSession Session
@inject AuthKitUiOptions Options

<AkShell Title="@L["change.title"]" Embedded="Embedded">
    <form class="ak-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault novalidate>
        <AkErrorAlert Error="_error" />

        @if (_done)
        {
            <div class="ak-alert ak-alert--success" role="status">@L["change.done"]</div>
        }

        <AkField Id="ak-change-current" Label="@L["common.current_password"]" Type="AkFieldType.Password" Required="true"
                 Autocomplete="current-password" @bind-Value="_current" Error="@_currentError" />

        <AkField Id="ak-change-new" Label="@L["common.new_password"]" Type="AkFieldType.Password" Required="true"
                 Autocomplete="new-password" Hint="@L.Format("common.too_short", Options.Register.PasswordMinLength)"
                 @bind-Value="_new" Error="@_newError" />

        <AkField Id="ak-change-confirm" Label="@L["common.confirm_password"]" Type="AkFieldType.Password" Required="true"
                 Autocomplete="new-password" @bind-Value="_confirm" Error="@_confirmError" />

        <AkSubmit Busy="_busy" Text="@L["change.submit"]" />
    </form>
</AkShell>

@code {
    [Parameter] public bool Embedded { get; set; } = true;

    private string _current = "";
    private string _new = "";
    private string _confirm = "";
    private string? _currentError;
    private string? _newError;
    private string? _confirmError;
    private ApiError? _error;
    private bool _busy;
    private bool _done;

    private async Task SubmitAsync()
    {
        if (_busy) return;

        _error = null;
        _done = false;
        _currentError = AkValidation.Required(L, _current);
        _newError = AkValidation.NewPassword(L, _new, Options.Register.PasswordMinLength);
        _confirmError = AkValidation.Confirm(L, _new, _confirm);
        if (_currentError is not null || _newError is not null || _confirmError is not null) return;

        _busy = true;
        try
        {
            var result = await Api.ChangePasswordAsync(_current, _new);
            if (!result.IsSuccess)
            {
                _error = result.Error;
                return;
            }

            await Session.SignInAsync(result.Value!);
            _current = _new = _confirm = "";
            _done = true;
        }
        finally { _busy = false; }
    }
}