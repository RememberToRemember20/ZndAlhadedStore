@inherits AkComponentBase
@inject IAuthKitApi Api
@inject NavigationManager Nav
@inject AuthKitUiOptions Options

<AkShell Title="@L["reset.title"]" Subtitle="@(_done || _missing ? null : L["reset.subtitle"])" Embedded="Embedded">
    @if (_done)
    {
        <div class="ak-alert ak-alert--success" role="status">@L["reset.done"]</div>
        <div class="ak-footer"><a class="ak-link" href="@Options.Routes.Login">@L["common.back_to_login"]</a></div>
    }
    else if (_missing)
    {
        <div class="ak-alert ak-alert--error" role="alert">@L["reset.missing_link"]</div>
        <div class="ak-footer"><a class="ak-link" href="@Options.Routes.ForgotPassword">@L["reset.request_new"]</a></div>
    }
    else
    {
        <form class="ak-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault novalidate>
            <AkErrorAlert Error="_error" />

            <AkField Id="ak-reset-password" Label="@L["common.new_password"]" Type="AkFieldType.Password" Required="true"
                     Autocomplete="new-password" Hint="@L.Format("common.too_short", Options.Register.PasswordMinLength)"
                     @bind-Value="_password" Error="@_passwordError" />

            <AkField Id="ak-reset-confirm" Label="@L["common.confirm_password"]" Type="AkFieldType.Password" Required="true"
                     Autocomplete="new-password" @bind-Value="_confirm" Error="@_confirmError" />

            <AkSubmit Busy="_busy" Text="@L["reset.submit"]" />

            @if (_error?.Code == "invalid_link")
            {
                <div class="ak-footer"><a class="ak-link" href="@Options.Routes.ForgotPassword">@L["reset.request_new"]</a></div>
            }
        </form>
    }
</AkShell>

@code {
    [Parameter] public string? Email { get; set; }
    [Parameter] public string? Token { get; set; }
    [Parameter] public bool Embedded { get; set; }

    private string _password = "";
    private string _confirm = "";
    private string? _passwordError;
    private string? _confirmError;
    private ApiError? _error;
    private bool _busy;
    private bool _done;
    private bool _missing;
    private bool _cleanUrl;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (string.IsNullOrEmpty(Token)) { Token = AkUrl.Query(Nav, "token"); _cleanUrl |= Token is not null; }
        if (string.IsNullOrEmpty(Email)) { Email = AkUrl.Query(Nav, "email"); _cleanUrl |= Email is not null; }

        _missing = string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || !_cleanUrl) return;

        _cleanUrl = false;
        Nav.NavigateTo(AkUrl.WithoutQuery(Nav), new NavigationOptions { ReplaceHistoryEntry = true });
    }

    private async Task SubmitAsync()
    {
        if (_busy) return;

        _error = null;
        _passwordError = AkValidation.NewPassword(L, _password, Options.Register.PasswordMinLength);
        _confirmError = AkValidation.Confirm(L, _password, _confirm);
        if (_passwordError is not null || _confirmError is not null) return;

        _busy = true;
        try
        {
            var result = await Api.ResetPasswordAsync(Email!, Token!, _password);
            if (result.IsSuccess) { _done = true; _password = _confirm = ""; }
            else _error = result.Error;
        }
        finally { _busy = false; }
    }
}