<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <RootNamespace>AuthKit</RootNamespace>

	  <PackageId>AuthKit</PackageId>
	  <Authors>Yihea</Authors>
	  <Description>Authentication and authorization toolkit for ASP.NET Core: Identity, JWT, RBAC and audit logging.</Description>
	  <PackageTags>auth;jwt;identity;rbac</PackageTags>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <UserSecretsId>c14c8c2e-f1e5-47a9-ab58-ae50646b334b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Features\Auth\Register\Query\**" />
    <Compile Remove="Features\Auth\Role\Query\**" />
    <EmbeddedResource Remove="Features\Auth\Register\Query\**" />
    <EmbeddedResource Remove="Features\Auth\Role\Query\**" />
    <None Remove="Features\Auth\Register\Query\**" />
    <None Remove="Features\Auth\Role\Query\**" />
  </ItemGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <PackageReference Include="MediatR" Version="14.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="6.0.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
